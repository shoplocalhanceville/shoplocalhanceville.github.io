{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:8080/",
        "http://localhost:8080/businesses.html",
        "http://localhost:8080/events.html",
        "http://localhost:8080/places.html",
        "http://localhost:8080/place-cut-n-up-barber-and-style.html"
      ],
      "numberOfRuns": 5,
      "startServerCommand": "python3 -m http.server 8080",
      "startServerReadyPattern": "Serving HTTP",
      "settings": {
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ],
        "chromeFlags": "--no-sandbox --headless --disable-dev-shm-usage",
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "emulatedUserAgent": "Mozilla/5.0 (Linux; Android 11; moto g power (2022)) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/136.0.0.0 Mobile Safari/537.36",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675,
          "cpuSlowdownMultiplier": 4
        }
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 1.0,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 1.0,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1.0,
            "aggregationMethod": "median-run"
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 1.0,
            "aggregationMethod": "median-run"
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 2500,
            "aggregationMethod": "median-run"
          }
        ],
        "first-contentful-paint": [
          "error",
          {
            "maxNumericValue": 1800,
            "aggregationMethod": "median-run"
          }
        ],
        "speed-index": [
          "error",
          {
            "maxNumericValue": 3400,
            "aggregationMethod": "median-run"
          }
        ],
        "interactive": [
          "error",
          {
            "maxNumericValue": 3800,
            "aggregationMethod": "median-run"
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 200,
            "aggregationMethod": "median-run"
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:total:size": [
          "error",
          {
            "maxNumericValue": 1048576,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:script:size": [
          "error",
          {
            "maxNumericValue": 358400,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:total:count": [
          "error",
          {
            "maxNumericValue": 80,
            "aggregationMethod": "median-run"
          }
        ],
        "unsized-images": [
          "error",
          {
            "minScore": 1.0,
            "aggregationMethod": "median-run"
          }
        ],
        "errors-in-console": [
          "error",
          {
            "minScore": 1.0,
            "aggregationMethod": "median-run"
          }
        ],
        "resource-summary:document:size": [
          "error",
          {
            "maxNumericValue": 720896,
            "aggregationMethod": "median-run"
          }
        ],
        "cls-culprits-insight": "warn",
        "document-latency-insight": "warn",
        "image-delivery-insight": "warn",
        "network-dependency-tree-insight": "warn",
        "uses-responsive-images": "warn",
        "uses-text-compression": "warn",
        "valid-source-maps": "warn",
        "unused-css-rules": "warn",
        "unused-javascript": "warn"
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-reports/mobile"
    }
  }
}
